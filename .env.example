# ---------------------------------------------------------------------------
# ORBIT Olympiad — environment configuration
# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit it.
# ---------------------------------------------------------------------------

# Port the HTTP server listens on.
PORT=3000

# "production" enables secure cookies + HSTS. Leave empty/development locally.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A (default, zero-setup): embedded PostgreSQL via PGlite.
# Data is stored in ./data/pglite and survives restarts.
# DATABASE_URL=

# Option B (recommended for production): a hosted PostgreSQL / Supabase pooler URL.
# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:6543/postgres
# DATABASE_SSL=true

# Directory used for the embedded database + local scratch data.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------
# Created automatically on first boot when no admin exists.
# If ADMIN_PASSWORD is omitted a strong random password is generated and printed
# once to the console (and written to data/admin-credentials.txt).
ADMIN_EMAIL=organizer@orbit-olympiad.org
ADMIN_PASSWORD=change-me-before-you-deploy
ADMIN_NAME=Event Organizer

# ---------------------------------------------------------------------------
# Optional: trusted proxy hops (1 when running behind Vercel/Nginx/Cloudflare)
# ---------------------------------------------------------------------------
TRUST_PROXY=1

# Session lifetime in days.
SESSION_DAYS=30
