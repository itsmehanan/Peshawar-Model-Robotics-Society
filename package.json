{
  "name": "pmrs-society",
  "version": "2.0.0",
  "private": true,
  "description": "Peshawar Model Robotics Society - website, registration portal and organiser CMS",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tests/api.test.js",
    "admin:set-password": "node scripts/set-admin-password.js",
    "db:reset": "node scripts/reset-db.js",
    "test:ui": "node tests/ui.test.js",
    "test:all": "node tests/api.test.js && node tests/ui.test.js && node tests/contrast.test.js && node tests/hero-framing.test.js",
    "build:hero": "esbuild public/assets/js/hero3d.js --bundle --format=esm --minify --target=es2020 --outfile=public/assets/js/hero3d.build.js --log-level=warning",
    "brand": "node scripts/brand-logos.mjs",
    "assets": "npm run brand && npm run build:hero",
    "test:contrast": "node tests/contrast.test.js",
    "test:hero": "node tests/hero-framing.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1"
  }
}
